  "solo": "async function startBookNaviSoloV89Final(){const bg=storySceneBg('unfinishedBook',3);return new Promise(async resolve=>{scriptedBattleResolve=resolve;await startBattleLoaded({mode:'story',returnScreen:'adventure',enemyConfigs:[{id:'book-navi',level:90}],party:[levelRowV89Final('yusha')],bg:bg.bg,fallbackBg:bg.fallback,bossBattle:true,scriptedTurnLimit:3,scriptedImmortalEnemy:true,scriptedImmortalParty:true,bookHeroPower:true,storyLabel:'モブナビ EVENT BATTLE'});});}",
  "master": "async function startBookNaviMasterV161(){\n  const party=state.party.slice(0,10).map(x=>[x[0],Number(x[1])||1]);\n  const k=player('kaijin');\n  if(k){\n    state.meta.ultimateCooldowns=state.meta.ultimateCooldowns||{};\n    state.meta.ultimateCooldowns.kaijin=(k.ults||[]).map(()=>0);\n    saveMeta();\n  }\n  const bg=storySceneBg('unfinishedBook',3);\n  return new Promise(async resolve=>{\n    scriptedBattleResolve=resolve;\n    await startBattleLoaded({mode:'story',returnScreen:'adventure',enemyConfigs:[{id:'book-navi-master',level:90}],party,bg:bg.bg,fallbackBg:bg.fallback,bossBattle:true,scriptedImmortalParty:false,bookHeroPower:true,bookNaviMasterFinal:true,storyLabel:'モブナビマスター FINAL BATTLE'});\n  });\n}"
