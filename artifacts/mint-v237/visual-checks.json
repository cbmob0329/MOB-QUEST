  "lines": [
    {
      "text": "よし！最後のゲーム始めるよ！",
      "name": "モブミント",
      "x": 74.0199966430664,
      "w": 246.96002197265625,
      "y": 328.50250244140625,
      "h": 67.6199951171875
    },
    {
      "text": "やっぱり、\n不気味であります・・",
      "name": "モブピンク",
      "x": 7.9199981689453125,
      "w": 188.16000366210938,
      "y": 597.2587280273438,
      "h": 89.66998291015625
    },
    {
      "text": "なんか寒いニョロ～",
      "name": "モブニョロ",
      "x": 181.50436401367188,
      "w": 173.45999145507812,
      "y": 630.1118774414062,
      "h": 67.6199951171875
    },
    {
      "text": "でも楽しいこともあるのよ",
      "name": "モブジェシー",
      "x": 16.954376220703125,
      "w": 217.55999755859375,
      "y": 617.0806274414062,
      "h": 67.6199951171875
    },
    {
      "text": "楽しいことでやんすか!?",
      "name": "モブデンデン",
      "x": 96.58124542236328,
      "w": 200.9000244140625,
      "y": 628.5806274414062,
      "h": 67.6199951171875
    },
    {
      "text": "ええ娯楽がちゃんとあるわ",
      "name": "モブジェシー",
      "x": 16.954376220703125,
      "w": 217.55999755859375,
      "y": 617.0650024414062,
      "h": 67.6199951171875
    },
    {
      "text": "ニョロ～",
      "name": "モブニョロ",
      "x": 199.25936889648438,
      "w": 137.19998168945312,
      "y": 630.1118774414062,
      "h": 67.6199951171875
    },
    {
      "text": "わわ！なんで人がいるの！？",
      "name": "モブミント",
      "x": 81.70375061035156,
      "w": 231.28001403808594,
      "y": 327.67437744140625,
      "h": 67.6199951171875
    },
    {
      "text": "ま、魔王軍でやんすか！？",
      "name": "モブデンデン",
      "x": 88.89749908447266,
      "w": 216.58001708984375,
      "y": 629.1118774414062,
      "h": 67.6199951171875
    },
    {
      "text": "いや！！",
      "name": "モブピンク",
      "x": 7.400001525878906,
      "w": 137.20001220703125,
      "y": 619.0962524414062,
      "h": 67.6199951171875
    },
    {
      "text": "村の新しいボス！\nでありますね！？",
      "name": "モブピンク",
      "x": 7.6199951171875,
      "w": 158.760009765625,
      "y": 595.9462280273438,
      "h": 89.66998291015625
    },
    {
      "text": "どっちも違うわよ",
      "name": "モブジェシー",
      "x": 46.23500061035156,
      "w": 157.77999877929688,
      "y": 617.0806274414062,
      "h": 67.6199951171875
    },
    {
      "text": "モブジェシー？\nどこ行ってたの！",
      "name": "モブミント",
      "x": 117.70375061035156,
      "w": 157.78001403808594,
      "y": 305.8525085449219,
      "h": 89.67001342773438
    },
    {
      "text": "元気そうね\n私は今勇者パーティーなの",
      "name": "モブジェシー",
      "x": 16.954376220703125,
      "w": 217.55999755859375,
      "y": 595.2431030273438,
      "h": 89.66998291015625
    },
    {
      "text": "勇者様！？\nどれが！？",
      "name": "モブミント",
      "x": 127.7750015258789,
      "w": 137.20001220703125,
      "y": 305.4306335449219,
      "h": 89.67001342773438
    },
    {
      "text": "この方でありますー！！",
      "name": "モブピンク",
      "x": 183.19500732421875,
      "w": 202.8599853515625,
      "y": 619.0962524414062,
      "h": 67.6199951171875
    },
    {
      "text": "そういうことなの",
      "name": "モブジェシー",
      "x": 45.7449951171875,
      "w": 158.760009765625,
      "y": 617.0806274414062,
      "h": 67.6199951171875
    },
    {
      "text": "そっかちょっと寂しいな",
      "name": "モブミント",
      "x": 95.61687469482422,
      "w": 202.8599853515625,
      "y": 327.67437744140625,
      "h": 67.6199951171875
    },
    {
      "text": "一緒に来ればいいでやんす♪",
      "name": "モブデンデン",
      "x": 82.1781234741211,
      "w": 230.29998779296875,
      "y": 629.1118774414062,
      "h": 67.6199951171875
    },
    {
      "text": "仲間は、\n多い方がいいであります♪",
      "name": "モブピンク",
      "x": 8.220001220703125,
      "w": 217.55999755859375,
      "y": 597.4149780273438,
      "h": 89.66998291015625
    },
    {
      "text": "そんな危ないこと\nこの子にさせられないわ",
      "name": "モブジェシー",
      "x": 24.14812469482422,
      "w": 202.8599853515625,
      "y": 595.4149780273438,
      "h": 89.66998291015625
    },
    {
      "text": "ねえモブミント、",
      "name": "モブジェシー",
      "x": 45.7449951171875,
      "w": 158.760009765625,
      "y": 616.7681274414062,
      "h": 67.6199951171875
    },
    {
      "text": "ダイヤを\n少し分けてもらえないかしら？",
      "name": "モブジェシー",
      "x": 8.519996643066406,
      "w": 246.96002197265625,
      "y": 594.2431030273438,
      "h": 89.66998291015625
    },
    {
      "text": "ダイヤを？",
      "name": "モブミント",
      "x": 127.7750015258789,
      "w": 137.20001220703125,
      "y": 327.67437744140625,
      "h": 67.6199951171875
    },
    {
      "text": "ダイヤがあるニョロ？",
      "name": "モブニョロ",
      "x": 174.78500366210938,
      "w": 187.18002319335938,
      "y": 630.2525024414062,
      "h": 67.6199951171875
    },
    {
      "text": "あるでやんすか！？",
      "name": "モブデンデン",
      "x": 110.50999450683594,
      "w": 172.47999572753906,
      "y": 629.2525024414062,
      "h": 67.6199951171875
    },
    {
      "text": "え～う～ん",
      "name": "モブミント",
      "x": 127.7750015258789,
      "w": 137.20001220703125,
      "y": 328.50250244140625,
      "h": 67.6199951171875
    },
    {
      "text": "モブジェシーの頼みなら\n断れないけど",
      "name": "モブミント",
      "x": 95.61687469482422,
      "w": 202.8599853515625,
      "y": 304.2275085449219,
      "h": 89.67001342773438
    },
    {
      "text": "私と遊んでくれる？",
      "name": "モブミント",
      "x": 110.49436950683594,
      "w": 172.47999572753906,
      "y": 323.08062744140625,
      "h": 67.6199951171875
    },
    {
      "text": "もちろんであります！",
      "name": "モブピンク",
      "x": 7.909996032714844,
      "w": 187.17999267578125,
      "y": 619.2368774414062,
      "h": 67.6199951171875
    },
    {
      "text": "じゃあ奥で待ってるね",
      "name": "モブミント",
      "x": 102.81062316894531,
      "w": 188.16001892089844,
      "y": 323.17437744140625,
      "h": 67.6199951171875
    },
    {
      "text": "敵であります！！",
      "name": "モブピンク",
      "x": 7.6199951171875,
      "w": 158.760009765625,
      "y": 619.0962524414062,
      "h": 67.6199951171875
    },
    {
      "text": "倒してモブミントを追いかけるニョロ！",
      "name": "モブニョロ",
