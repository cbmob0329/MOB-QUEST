air.gethit.groundrecover.groundlevel = 0
air.gethit.airrecover.threshold = -1
air.gethit.airrecover.yaccel = .35
air.gethit.trip.groundlevel = 0
down.bounce.offset = 0,0
down.bounce.yaccel = .4
down.bounce.groundlevel = 0
down.friction.threshold = .05


[Statedef -2]

[State -2, normal receipt before command cancellation]
type = PowerAdd
triggerall = !IsHelper
trigger1 = Alive && RoundState = 2 && ((StateNo = [200,202]) || (StateNo = [210,212]) || (StateNo = [220,222]) || (StateNo = [400,402]) || (StateNo = [410,412]) || (StateNo = [420,422]) || (StateNo = [600,602]) || (StateNo = [610,612]) || (StateNo = [620,622])) && MoveType = A && MoveContact > 0 && var(32) = 0
value = ifelse(MoveHit,120,40)
ignorehitpause = 1


[State -2, one receipt per actual normal stage]
type = VarSet
triggerall = !IsHelper
trigger1 = Alive && RoundState = 2 && ((StateNo = [200,202]) || (StateNo = [210,212]) || (StateNo = [220,222]) || (StateNo = [400,402]) || (StateNo = [410,412]) || (StateNo = [420,422]) || (StateNo = [600,602]) || (StateNo = [610,612]) || (StateNo = [620,622])) && MoveType = A && MoveContact > 0 && var(32) = 0
v = 32
value = 1
ignorehitpause = 1


[State -2, pay queued contact gain]
type = PowerAdd
triggerall = !IsHelper
triggerall = Alive && RoundState = 2
trigger1 = var(9) > 0
value = var(9)
ignorehitpause = 1

[State -2, ledger]
type = VarSet
trigger1 = !IsHelper
v = 9
value = 0
ignorehitpause = 1

[State -2, cooldown never shortened on interruption]
