air.gethit.groundrecover.ground.threshold = -16
air.gethit.groundrecover.groundlevel = 0
air.gethit.airrecover.threshold = -1
air.gethit.airrecover.yaccel = .35
air.gethit.trip.groundlevel = 0
down.bounce.offset = 0,0
down.bounce.yaccel = .4
down.bounce.groundlevel = 0
down.friction.threshold = .05

[Statedef 180]
type = S
movetype = I
physics = S
anim = 180
velset = 0,0
ctrl = 0
[State 180, Stay grounded]
type = PosSet
trigger1 = 1
y = 0

[Statedef 191]
type = S
movetype = I
physics = S
anim = 190
velset = 0,0
ctrl = 0
[State 191, Intro wait]
type = AssertSpecial
trigger1 = AnimTime != 0
flag = intro
[State 191, Ready]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[Statedef 195]
type = S
movetype = I
physics = S
anim = 195
velset = 0,0
ctrl = 0
[State 195, End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


[Statedef 100]
type = S
movetype = I
physics = N
anim = 100
ctrl = 1



[State 100, Small separate grounded foot dust]
type=Explod
triggerall=Pos Y=0 && Abs(Vel X)>1
trigger1=Time=1 || Time=9
anim=F120
postype=p1
pos=-8,0
bindtime=1
removetime=-2
scale=.35,.35
sprpriority=-1
ownpal=1
removeongethit=1
[State 100, A168 finite dash body trail]
type = AfterImage
trigger1 = Time % 4 = 0
time = 6
length = 3
timegap = 1
framegap = 2
palcolor = 128
palbright = 0,0,0
palcontrast = 128,128,128
paladd = 0,0,0
palmul = .7,.7,.7
trans = add

[State 100, R27 prevent engine run to walk cancellation]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, R27 keep dash facing]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn
[State 100, Run]
type = VelSet
trigger1 = 1
x = Const(velocity.run.fwd.x)
y = 0
[State 100, Stop]
type = ChangeState
trigger1 = AILevel = 0
trigger1 = Time >= 12
trigger1 = command != "holdfwd"
trigger2 = AILevel > 0
trigger2 = P2Dist X <= 46
trigger3 = RoundState != 2
value = 0
ctrl = 1

; Guard state in standard guard-number range, retaining common guard-hit handling.
[Statedef 130]
type = S
movetype = I
physics = S
anim = 130
ctrl = 0
velset = 0,0
[State 130, Release]
type = ChangeState
trigger1 = AILevel = 0
trigger1 = command != "holdback"
trigger2 = AILevel > 0
trigger2 = P2MoveType != A
trigger2 = Time > 8
trigger3 = AILevel > 0
trigger3 = Abs(P2BodyDist X) > 88.636364
trigger4 = RoundState != 2
value = 140
[State 130, Guard height]
type = ChangeState
trigger1 = AILevel = 0
trigger1 = command = "holddown"
trigger2 = AILevel > 0
trigger2 = P2StateType = C
value = 131

