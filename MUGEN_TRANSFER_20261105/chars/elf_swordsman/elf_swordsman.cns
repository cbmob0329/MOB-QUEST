[Statedef -3]

[State -3, JUS Own state marker]
type = VarSet
trigger1 = 1
v = 59
value = GameTime
ignorehitpause = 1


[State -3, JUS Real landing or new round reset 32]
type = VarSet
trigger1 = RoundState != 2
trigger2 = Pos Y >= 0 && Vel Y >= 0 && MoveType != H && (StateNo = 0 || StateNo = 10 || StateNo = 11 || StateNo = 12 || StateNo = 20 || StateNo = 21 || StateNo = 52 || StateNo = 106 || StateNo = 601 || StateNo = 611 || StateNo = 621 || StateNo = 1101)
v = 32
value = 0

[State -3, JUS Real landing or new round reset 12]
type = VarSet
trigger1 = RoundState != 2
trigger2 = Pos Y >= 0 && Vel Y >= 0 && MoveType != H && (StateNo = 0 || StateNo = 10 || StateNo = 11 || StateNo = 12 || StateNo = 20 || StateNo = 21 || StateNo = 52 || StateNo = 106 || StateNo = 601 || StateNo = 611 || StateNo = 621 || StateNo = 1101)
v = 12
value = 0

[State -3, JUS Real landing or new round reset 13]
type = VarSet
trigger1 = RoundState != 2
trigger2 = Pos Y >= 0 && Vel Y >= 0 && MoveType != H && (StateNo = 0 || StateNo = 10 || StateNo = 11 || StateNo = 12 || StateNo = 20 || StateNo = 21 || StateNo = 52 || StateNo = 106 || StateNo = 601 || StateNo = 611 || StateNo = 621 || StateNo = 1101)
v = 13
value = 0

; JUS-owned 40/45/50/52 removes hidden host airjump counters. Existing ascent/landing
; artwork is reused honestly; independent second-jump reaction art/FX is still pending.
[Statedef 700]
type = S
movetype = I
physics = S
anim = 40
ctrl = 0
[State 700, JUS CPU shares ground admission]
type = VarSet
trigger1 = 1
v = 47
value = 1
[State 700, JUS same ground startup]
type = ChangeState
trigger1 = 1
value = 40
ctrl = 0
[Statedef 40]
type = S
movetype = I
physics = N
anim = 40
ctrl = 0
velset = 0,0

[State 40, JUS Reject inactive round ground entry]
type = ChangeState
trigger1 = Time = 0
trigger1 = RoundState != 2 || Alive = 0
value = 0
ctrl = 1

[State 40, JUS Capture jump direction]
type = VarSet
trigger1 = Time = 0
v = 46
value = ifelse(AILevel > 0,1,ifelse(command = "holdfwd",ifelse(PrevStateNo = 100,2,1),ifelse(command = "holdback",-1,0)))

[State 40, JUS Six tick ground preparation]
type = VelSet
triggerall = RoundState = 2
triggerall = Alive
triggerall = Life > 0
triggerall = !IsHelper
triggerall = HitPauseTime = 0
trigger1 = Time = 6
x = ifelse(var(46) = 2,Const(velocity.runjump.fwd.x),ifelse(var(46) = 1,Const(velocity.jump.fwd.x),ifelse(var(46) = -1,Const(velocity.jump.back.x),Const(velocity.jump.neu.x))))
y = Const(velocity.jump.y)

[State 40, JUS Ground takeoff]
type = ChangeState
trigger1 = Time = 6
value = 50
ctrl = 1

[Statedef 45]
type = A
movetype = I
physics = N
anim = 41
ctrl = 0


[State 45, R8 consume air buffer]
type = VarSet
ignorehitpause = 1
trigger1 = Time = 0
v = 57
value = 0
[State 45, JUS Reject unadmitted or exhausted air jump]
type = ChangeState
trigger1 = Time = 0
trigger1 = var(32) != 0 || RoundState != 2 || Alive = 0 || Pos Y > -Const(movement.airjump.height)
value = 50
ctrl = 1

[State 45, JUS Consume only extra jump]
type = VarSet
trigger1 = Time = 0
v = 32
value = 1

[State 45, JUS Consume fresh air jump buffer]
type = VarSet
trigger1 = Time = 0
v = 57
value = 0

[State 45, JUS Air impulse same human CPU]
type = VelSet
triggerall = RoundState = 2
triggerall = Alive
triggerall = Life > 0
triggerall = !IsHelper
triggerall = HitPauseTime = 0
trigger1 = Time = 0
x = ifelse(AILevel > 0,Const(velocity.airjump.fwd.x),ifelse(command = "holdfwd",Const(velocity.airjump.fwd.x),ifelse(command = "holdback",Const(velocity.airjump.back.x),Const(velocity.airjump.neu.x))))
y = Const(velocity.airjump.y)

[State 45, JUS Gravity during two tick air reaction]
type = VelAdd
trigger1 = Time < 2
y = Const(movement.yaccel)

[State 45, JUS Finish air reaction]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

[Statedef 50]
type = A
movetype = I
physics = N
anim = 41
ctrl = 1

[State 50, JUS Directional existing ascent pose]
