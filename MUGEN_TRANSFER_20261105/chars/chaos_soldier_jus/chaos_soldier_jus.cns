[Statedef -2]
type=S
movetype=I
physics=S




[State -2, AI observed attack time]
type=VarAdd
triggerall=!IsHelper && AILevel>0 && NumEnemy>0
trigger1=P2MoveType=A && var(53)<30
v=53
value=1

[State -2, AI reset observation]
type=VarSet
triggerall=!IsHelper
trigger1=RoundState!=2 || AILevel=0
trigger2=NumEnemy>0 && P2MoveType!=A
v=53
value=0

[State -2, AI cooldown]
type=VarAdd
trigger1=!IsHelper && var(50)>0
v=50
value=-1
ignorehitpause=1

[State -2, AI remember special]
type=VarSet
triggerall=!IsHelper && AILevel>0 && StateNo!=var(52)
trigger1=StateNo=1000 || StateNo=1100 || StateNo=1200 || StateNo=1300 || StateNo=3000 || StateNo=3100 || StateNo=3200
v=51
value=StateNo
ignorehitpause=1

[State -2, AI space specials]
type=VarSet
triggerall=!IsHelper && AILevel>0 && StateNo!=var(52)
trigger1=StateNo=1000 || StateNo=1100 || StateNo=1200 || StateNo=1300 || StateNo=3000 || StateNo=3100 || StateNo=3200
v=50
value=ifelse(StateNo>=3000,180,100)
ignorehitpause=1

[State -2, AI previous state]
type=VarSet
trigger1=!IsHelper
v=52
value=StateNo
ignorehitpause=1
[State -2, one real contact per body action]
type=PowerAdd
trigger1=!IsHelper && (StateNo=200 || StateNo=210 || StateNo=220 || StateNo=400 || StateNo=410 || StateNo=600 || StateNo=610 || StateNo=1000 || StateNo=1100 || StateNo=1200 || StateNo=1300) && MoveType=A && MoveContact && !var(35)
value=ifelse(MoveHit,120,40)
ignorehitpause=1

[State -2, latch paid body action]
type=VarSet
trigger1=!IsHelper && (StateNo=200 || StateNo=210 || StateNo=220 || StateNo=400 || StateNo=410 || StateNo=600 || StateNo=610 || StateNo=1000 || StateNo=1100 || StateNo=1200 || StateNo=1300) && MoveType=A && MoveContact && !var(35)
v=35
value=1
ignorehitpause=1

[State -2, special meter]
type=PowerAdd
trigger1=!IsHelper && var(37)>0
value=var(37)
ignorehitpause=1

[State -2, clear meter]
type=VarSet
trigger1=!IsHelper
v=37
value=0
ignorehitpause=1

[State -2, save armored move]
type=VarSet
trigger1=!IsHelper && MoveType=A && StateNo != 799 && StateNo < 4000 && Alive && RoundState=2
v=20
value=StateNo
ignorehitpause=1

[State -2, save animation phase]
type=VarSet
trigger1=!IsHelper && MoveType=A && StateNo != 799 && StateNo < 4000 && Alive && RoundState=2
v=21
value=AnimElemNo(0)
ignorehitpause=1

[State -2, save horizontal momentum]
type=VarSet
trigger1=!IsHelper && MoveType=A && StateNo != 799 && StateNo < 4000 && Alive && RoundState=2
fv=0
value=Vel X
ignorehitpause=1

[State -2, save vertical momentum]
type=VarSet
trigger1=!IsHelper && MoveType=A && StateNo != 799 && StateNo < 4000 && Alive && RoundState=2
fv=1
value=Vel Y
ignorehitpause=1

[State -2, attack armor excluding throws]
type=HitOverride
trigger1=!IsHelper && MoveType=A && StateNo != 799 && StateNo < 4000 && Alive && RoundState=2
attr=SCA, NA, SA, HA, NP, SP, HP
slot=0
stateno=799
time=1
forceair=0
ignorehitpause=1

[State -2, guard sound]
type=PlaySnd
trigger1=!IsHelper && (StateNo=[150,155]) && Time=0
value=0,4
channel=2

[State -2, effect]
type=Explod
trigger1=!IsHelper && MoveType=H && Time=0 && StateNo!=799
anim=8210
pos=0,-30
postype=p1
bindtime=1
removetime=-2
ownpal=1
sprpriority=3
scale=.5,.5

