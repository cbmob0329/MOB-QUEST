[Statedef -2]

[State ]
type=null
trigger1=stateno=5900&&time<=2
trigger1=var(59):=0
trigger2=var(59)<3
trigger2=var(59):=var(59)+1
ignorehitpause=1
 
[State ]
type=assertspecial
trigger1=var(59)=1
flag=noko
ignorehitpause=1
 
[State ]
type=lifeset
trigger1=var(59)<=2
value=lifemax*(var(59)=2)
ignorehitpause=1
 
[State ]
type=null
trigger1=var(59)=1
trigger1=var(58):=life
ignorehitpause=1
 
[State ]
type=displaytoclipboard
trigger1=1
text="Training Mode=%d 0=No 1=Yes"
params=var(58)
ignorehitpause=1

[state 0]
type = helper
trigger1 = ((var(58) = 1) && ((!ailevel) && (alive) && (numhelper(9900) = 0)))
stateno = 9900
id = 9900
pos = 0,0
postype = p1
ownpal = 1
ignorehitpause = 1
persistent = 0

[State 0, Run]
type = ChangeState
triggerall = var(5) = 0
triggerall = stateno != 60
triggerall = stateno != 65
triggerall = stateno != 70
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x > 100
trigger1 = random < (ailevel * 100)/2
value = ifelse(pos y >= 0,60,65)

[State 0, Run Atras]
type = ChangeState
triggerall = stateno != 60
triggerall = stateno != 65
triggerall = stateno != 70
triggerall = var(5) = 0
triggerall = backedgebodydist > 50
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = statetype != A
triggerall = p2bodydist x < 100 && p2movetype = A
trigger1 = random < (ailevel * 100)/4
value = 70

[State 0, Guard]
type = ChangeState
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = (p2bodydist x < 50 && p2movetype = A) || (enemy,numproj > 0)
trigger1 = random < (ailevel * 100)/2
value = ifelse(statetype = A,132,130)

[State 0, Power Charge]
