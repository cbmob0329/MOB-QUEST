; Own common mechanics adapted from audited original project source. No borrowed character art.
[Statedef 150]
type = S
movetype = H
physics = N
ctrl = 0
anim = 130
poweradd = 0

[State 150, hit velocity once after shake]
type = HitVelSet
ignorehitpause = 1
trigger1 = HitShakeOver
x = 1
y = 1

[State 150, KO stays in damage flow]
type = ChangeState
ignorehitpause = 1
trigger1 = Life <= 0
trigger1 = HitShakeOver
value = ifElse(StateType = A || Vel Y < 0, 5050, 5150)
ctrl = 0

[State 150, shake complete]
type = ChangeState
ignorehitpause = 1
trigger1 = Alive = 1
trigger1 = Life > 0
trigger1 = HitShakeOver
value = 151
ctrl = 0






[State 150, live crouch guard without restarting stun]
type = StateTypeSet
trigger1 = AILevel = 0 && command = "holddown"
trigger2 = AILevel > 0 && NumEnemy > 0 && P2StateType = C
statetype = C
ignorehitpause = 1

[State 150, live high guard without restarting stun]
type = StateTypeSet
trigger1 = AILevel = 0 && command != "holddown"
trigger2 = AILevel > 0 && NumEnemy > 0 && P2StateType != C
statetype = S
ignorehitpause = 1

[State 150, corresponding actual guard silhouette]
type = ChangeAnim
trigger1 = Anim != ifelse(StateType=C,131,130)
value = ifelse(StateType=C,131,130)
ignorehitpause = 1

[Statedef 151]
