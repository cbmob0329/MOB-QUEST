triggerall = (StateNo = [200,208]) || (StateNo = [400,408]) || (StateNo = [600,608]) || StateNo = 800 || StateNo = 801 || StateNo = 1000 || StateNo = 1100 || StateNo = 1200 || StateNo = 1300
trigger1 = HitCount > var(9)
v = 9
value = HitCount

[State -2, Delayed public-state AI attack]
type = VarSet
triggerall = AILevel > 0 && !IsHelper && NumEnemy > 0
triggerall = RoundState = 2 && Alive
trigger1 = GameTime % 12 = 0
v = 20
value = (P2BodyDist X = [0,42]) && P2MoveType != A

[State -2, Delayed public-state AI guard]
