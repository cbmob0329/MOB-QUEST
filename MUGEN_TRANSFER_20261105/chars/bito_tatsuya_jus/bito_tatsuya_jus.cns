trigger1 = RoundState != 2
trigger2 = var(58) = GameTime
trigger2 = Alive && MoveType != H && StateType != A && Pos Y >= 0
trigger2 = StateNo = 0 || StateNo = 11 || StateNo = 20 || StateNo = 21 || StateNo = 52
v = 0
value = 0

[State -2, Reset victim only round end or resolved target]
type = VarSet
trigger1 = RoundState != 2 || !Alive
v = 40
value = 0

[State -2, Release episode only all 1 enemies resolved]
