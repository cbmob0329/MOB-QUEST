trigger3 = !Alive
trigger4 = RoundState != 2
trigger5 = var(59) != 1
trigger6 = NumEnemy != 1
trigger7 = var(14) = 0
trigger8 = var(16) != var(21)
trigger9 = var(3) != 0
v = 18
value = 0
ignorehitpause = 1

