; Dark Magician original staff caster first version. No bundled third-party common states.
[Data]
life = 1000
power = 3000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 40
airjuggle = 8
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
IntPersistIndex = 60
FloatPersistIndex = 40
[Size]
xscale = 0.5
yscale = 0.5
ground.back = 14
ground.front = 15
air.back = 13
air.front = 13
height = 68
attack.dist = 80
proj.attack.dist = 80
proj.doscale = 0
head.pos = 0,-56
mid.pos = 0,-34
shadowoffset = 0
draw.offset = 0,0
[Velocity]
walk.fwd = 2.8
walk.back = -2.4
run.fwd = 3.335,0
run.back = -3.45,-5
jump.neu = 0,-9
jump.back = -2.3
jump.fwd = 2.53
runjump.back = -2.3,-6.72
runjump.fwd = 3.45,-6.72
airjump.neu = 0,-8.5
airjump.back = -2.3
airjump.fwd = 2.53
air.gethit.groundrecover = -.15,-3.2
air.gethit.airrecover.mul = .5,.2
air.gethit.airrecover.add = 0,-4.0
air.gethit.airrecover.back = -1
air.gethit.airrecover.fwd = 0
air.gethit.airrecover.up = -2
air.gethit.airrecover.down = 1.5
[Movement]
airjump.num = 1
airjump.height = 12
yaccel = .42
stand.friction = .85
crouch.friction = .82
stand.friction.threshold = .05
crouch.friction.threshold = .05
air.gethit.groundlevel = 0
air.gethit.groundrecover.ground.threshold = -16
air.gethit.groundrecover.groundlevel = 0
air.gethit.airrecover.threshold = -1
air.gethit.airrecover.yaccel = .35
air.gethit.trip.groundlevel = 0
down.bounce.offset = 0,0
down.bounce.yaccel = .4
down.bounce.groundlevel = 0
down.friction.threshold = .05


; JUS-C1: var(29) owns a 14-active-tick second-jump reservation only.
; var(30) is a one-evaluation own-state stamp, never a jump budget.
[Statedef -3]
[State -3, JUS-C1 own state stamp]
type = VarSet
trigger1 = 1
v = 30
value = GameTime
ignorehitpause = 1

[Statedef -2]


[State -2, AI reaction clock]
type=VarAdd
triggerall=!IsHelper && AILevel>0 && NumEnemy>0 && RoundState=2
trigger1=P2MoveType=A && fvar(36)<30
fv=36
value=1
[State -2, AI reaction reset]
type=VarSet
triggerall=!IsHelper
trigger1=RoundState!=2 || AILevel=0
trigger2=NumEnemy>0 && P2MoveType!=A
fv=36
value=0
[State -2, AI reuse clock]
type=VarAdd
trigger1=!IsHelper && fvar(37)>0
fv=37
value=-1
[State -2, AI track selected technique]
type=VarSet
triggerall=!IsHelper && AILevel>0 && StateNo!=fvar(39)
trigger1=StateNo=[11100,11170]
fv=38
value=StateNo
[State -2, AI finite technique interval]
type=VarSet
triggerall=!IsHelper && AILevel>0 && StateNo!=fvar(39)
trigger1=StateNo=[11100,11170]
fv=37
value=80
[State -2, AI previous state]
type=VarSet
trigger1=!IsHelper
fv=39
value=StateNo

[State -2, normal receipt before command cancellation]
type = PowerAdd
triggerall = !IsHelper
trigger1 = Alive && RoundState = 2 && ((StateNo = [200,202]) || (StateNo = [210,212]) || (StateNo = [220,222]) || (StateNo = [400,402]) || (StateNo = [410,412]) || (StateNo = [420,422]) || (StateNo = [600,602]) || (StateNo = [610,612]) || (StateNo = [620,622])) && MoveType = A && MoveContact > 0 && var(32) = 0
value = ifelse(MoveHit,120,40)
ignorehitpause = 1


[State -2, one receipt per actual normal stage]
type = VarSet
triggerall = !IsHelper
trigger1 = Alive && RoundState = 2 && ((StateNo = [200,202]) || (StateNo = [210,212]) || (StateNo = [220,222]) || (StateNo = [400,402]) || (StateNo = [410,412]) || (StateNo = [420,422]) || (StateNo = [600,602]) || (StateNo = [610,612]) || (StateNo = [620,622])) && MoveType = A && MoveContact > 0 && var(32) = 0
v = 32
value = 1
ignorehitpause = 1


[State -2, AI super budget round reset]
type = VarSet
triggerall = !IsHelper
trigger1 = RoundState != 2
v = 31
value = 0

[State -2, pay queued contact gain]
type = PowerAdd
triggerall = !IsHelper
triggerall = Alive && RoundState = 2
trigger1 = var(9) > 0
value = var(9)
ignorehitpause = 1

[State -2, ledger]
type = VarSet
trigger1 = !IsHelper
v = 9
value = 0
ignorehitpause = 1

[State -2, cooldown never shortened on interruption]
type = VarAdd
triggerall = !IsHelper
trigger1 = var(11) > 0
v = 11
value = -1
[State -2, cooldown never shortened on interruption]
type = VarAdd
triggerall = !IsHelper
trigger1 = var(13) > 0
v = 13
value = -1
[State -2, ledger]
type = VarSet
triggerall = !IsHelper
trigger1 = RoundState != 2
trigger2 = !Alive
trigger3 = NumEnemy = 0
trigger4 = NumEnemy = 1
trigger4 = EnemyNear, StateType != A
trigger4 = EnemyNear, MoveType != H
trigger5 = NumEnemy = 2
trigger5 = EnemyNear(0), StateType != A
trigger5 = EnemyNear(0), MoveType != H
trigger5 = EnemyNear(1), StateType != A
trigger5 = EnemyNear(1), MoveType != H
v = 14
value = 0
[State -2, ledger]
type = VarSet
triggerall = !IsHelper
trigger1 = RoundState != 2
trigger2 = !Alive
trigger3 = NumEnemy = 0
trigger4 = NumEnemy = 1
trigger4 = EnemyNear, StateType != A
trigger4 = EnemyNear, MoveType != H
trigger5 = NumEnemy = 2
trigger5 = EnemyNear(0), StateType != A
trigger5 = EnemyNear(0), MoveType != H
trigger5 = EnemyNear(1), StateType != A
trigger5 = EnemyNear(1), MoveType != H
v = 16
value = 0
[State -2, ledger]
type = VarSet
triggerall = !IsHelper
trigger1 = RoundState != 2
trigger2 = !Alive
trigger3 = NumEnemy = 0
trigger4 = NumEnemy = 1
trigger4 = EnemyNear, StateType != A
trigger4 = EnemyNear, MoveType != H
trigger5 = NumEnemy = 2
trigger5 = EnemyNear(0), StateType != A
trigger5 = EnemyNear(0), MoveType != H
trigger5 = EnemyNear(1), StateType != A
trigger5 = EnemyNear(1), MoveType != H
v = 24
value = 0
[State -2, ledger]
type = VarSet
triggerall = !IsHelper
trigger1 = NumEnemy > 0
v = 15
value = EnemyNear, ID
[State -2, ledger]
type = VarSet
triggerall = !IsHelper
trigger1 = RoundState != 2
trigger2 = Pos Y >= 0 && StateType != A && MoveType != H
v = 18
value = 0
[State -2, ledger]
type = VarSet
trigger1 = !IsHelper
v = 25
value = command = "holdup" && var(19) = 0
[State -2, ledger]
type = VarSet
trigger1 = !IsHelper
v = 19
value = command = "holdup"
; Runs after the existing up-edge and hold latch above, before State -1.
[State -2, JUS-C1 second jump reservation clock]
type = VarAdd
trigger1 = var(29) > 0 && HitPauseTime = 0
v = 29
value = -1
ignorehitpause = 1

[State -2, JUS-C1 reserve fresh second jump]
type = VarSet
trigger1 = !IsHelper && AILevel = 0
trigger1 = Alive && RoundState = 2 && MoveType != H
trigger1 = HitPauseTime = 0
trigger1 = var(30) = GameTime
trigger1 = var(25) = 1 && var(18) = 0
trigger1 = StateNo = 40 || StateNo = 50
v = 29
value = 14
ignorehitpause = 1

[State -2, JUS-C1 discard invalid reservation]
type = VarSet
trigger1 = IsHelper || AILevel != 0 || !Alive || RoundState != 2 || MoveType = H
trigger2 = var(30) != GameTime || var(18) != 0
trigger3 = StateNo != 40 && StateNo != 50
v = 29
value = 0
ignorehitpause = 1

[State -2, JUS-C1 invalidate own state stamp]
type = VarSet
trigger1 = 1
v = 30
value = -1
ignorehitpause = 1

[State -2, FX owner cleanup]
type = RemoveExplod
triggerall = !IsHelper
trigger1 = StateNo != 11100
trigger2 = !Alive
trigger3 = RoundState != 2
ID = 11800
[State -2, FX owner cleanup]
type = RemoveExplod
triggerall = !IsHelper
trigger1 = StateNo != 11110
trigger2 = !Alive
trigger3 = RoundState != 2
ID = 11810
[State -2, FX owner cleanup]
type = RemoveExplod
triggerall = !IsHelper
trigger1 = StateNo != 11120
trigger2 = !Alive
trigger3 = RoundState != 2
ID = 11820
[State -2, FX owner cleanup]
type = RemoveExplod
triggerall = !IsHelper
trigger1 = StateNo != 11130
trigger2 = !Alive
trigger3 = RoundState != 2
ID = 11830
[State -2, FX owner cleanup]
type = RemoveExplod
triggerall = !IsHelper
trigger1 = StateNo != 11140
trigger2 = !Alive
trigger3 = RoundState != 2
ID = 11840
[State -2, FX owner cleanup]
type = RemoveExplod
triggerall = !IsHelper
trigger1 = StateNo != 11150
trigger2 = !Alive
trigger3 = RoundState != 2
ID = 11850
[State -2, FX owner cleanup]
type = RemoveExplod
