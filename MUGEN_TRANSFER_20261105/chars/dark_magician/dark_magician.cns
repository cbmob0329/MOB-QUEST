trigger3 = RoundState != 2
ID = 11870
[State -2, FX owner cleanup]
type = RemoveExplod
triggerall = !IsHelper
trigger1 = StateNo != 11171
trigger2 = !Alive
trigger3 = RoundState != 2
ID = 11871
[State -2, FX owner cleanup]
type = RemoveExplod
triggerall = !IsHelper
trigger1 = StateNo != 11171
trigger2 = !Alive
trigger3 = RoundState != 2
ID = 11872
[State -2, finite audio abort]
type = StopSnd
trigger1 = !Alive
trigger2 = RoundState != 2
channel = 0
[State -2, finite audio abort]
type = StopSnd
trigger1 = !Alive
trigger2 = RoundState != 2
channel = 1
[State -2, finite audio abort]
type = StopSnd
trigger1 = !Alive
trigger2 = RoundState != 2
channel = 2


[State -2, cutin presentation cleanup 11900]
type = RemoveExplod
triggerall = !IsHelper
trigger1 = !Alive || RoundState != 2 || MoveType = H
trigger2 = StateNo != 11140 && StateNo != 11150 && StateNo != 11160 && StateNo != 11171
ID = 11900
ignorehitpause = 1

[State -2, cutin presentation cleanup 11910]
type = RemoveExplod
triggerall = !IsHelper
trigger1 = !Alive || RoundState != 2 || MoveType = H
trigger2 = StateNo != 11140 && StateNo != 11150 && StateNo != 11160 && StateNo != 11171
ID = 11910
ignorehitpause = 1

[Statedef 40]
type = S
movetype = I
physics = N
anim = 40
ctrl = 0
poweradd = 0
juggle = 0
[State 40, jump preparation]
type = VelSet
trigger1 = Time = 0
x = 0
y = 0
[State 40, ground jump impulse]
type = VelSet
