; Gaia original mounted candidate. No bundled third-party common states.
[Data]
life = 1000
power = 3000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 40
airjuggle = 4
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
IntPersistIndex = 60
FloatPersistIndex = 40
[Size]
xscale = 1.0
yscale = 1.0
ground.back = 29
ground.front = 35
air.back = 29
air.front = 35
height = 72
attack.dist = 80
proj.attack.dist = 80
proj.doscale = 0
head.pos = -4,-60
mid.pos = 0,-32
shadowoffset = 0
draw.offset = 0,0
[Velocity]
walk.fwd = 2.7
walk.back = -2.2
run.fwd = 6.2,0
run.back = -3.45,-5
jump.neu = 0,-8.7
jump.back = -2.3
jump.fwd = 2.53
runjump.back = -2.3,-6.72
runjump.fwd = 3.45,-6.72
airjump.neu = 0,-8.7
airjump.back = -2.3
airjump.fwd = 2.53
air.gethit.groundrecover = -.15,-3.2
air.gethit.airrecover.mul = .5,.2
air.gethit.airrecover.add = 0,-4.0
air.gethit.airrecover.back = -1
air.gethit.airrecover.fwd = 0
air.gethit.airrecover.up = -2
air.gethit.airrecover.down = 1.5
[Movement]
airjump.num = 1
airjump.height = 12
yaccel = .40
stand.friction = .85
crouch.friction = .82
stand.friction.threshold = .05
crouch.friction.threshold = .05
air.gethit.groundlevel = 0
air.gethit.groundrecover.ground.threshold = -16
air.gethit.groundrecover.groundlevel = 0
air.gethit.airrecover.threshold = -1
air.gethit.airrecover.yaccel = .35
air.gethit.trip.groundlevel = 0
down.bounce.offset = 0,0
down.bounce.yaccel = .4
down.bounce.groundlevel = 0
down.friction.threshold = .05


[Statedef 180]
type = S
movetype = I
physics = S
anim = 180
velset = 0,0
ctrl = 0
[State 180, Stay grounded]
type = PosSet
trigger1 = 1
y = 0

[Statedef 191]
type = S
movetype = I
physics = S
anim = 190
velset = 0,0
ctrl = 0
[State 191, Intro wait]
type = AssertSpecial
trigger1 = AnimTime != 0
flag = intro
[State 191, Ready]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[Statedef 195]
type = S
movetype = I
physics = S
anim = 195
velset = 0,0
ctrl = 0
[State 195, End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


[Statedef 100]
type = S
movetype = I
physics = N
anim = 100
ctrl = 1


[State 100, A168 finite dash body trail]
type = AfterImage
trigger1 = Time % 4 = 0
time = 6
length = 3
timegap = 1
framegap = 2
palcolor = 128
palbright = 0,0,0
palcontrast = 128,128,128
paladd = 0,0,0
palmul = .7,.7,.7
trans = add

[State 100, R27 prevent engine run to walk cancellation]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, R27 keep dash facing]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn
[State 100, Run]
type = VelSet
trigger1 = 1
x = Const(velocity.run.fwd.x)
y = 0
[State 100, Stop]
type = ChangeState
trigger1 = AILevel = 0
trigger1 = Time >= 12
trigger1 = command != "holdfwd"
trigger2 = AILevel > 0
trigger2 = P2BodyDist X <= 28.636364
trigger3 = RoundState != 2
value = 0
ctrl = 1

; Guard state in standard guard-number range, retaining common guard-hit handling.
[Statedef 130]
type = S
movetype = I
physics = S
anim = 130
ctrl = 0
velset = 0,0
[State 130, Release]
type = ChangeState
trigger1 = AILevel = 0
trigger1 = command != "holdback"
trigger2 = AILevel > 0
trigger2 = P2MoveType != A
trigger2 = Time > 8
trigger3 = AILevel > 0
trigger3 = Abs(P2BodyDist X) > 88.636364
trigger4 = RoundState != 2
value = 140
[State 130, Guard height]
type = ChangeState
trigger1 = AILevel = 0
trigger1 = command = "holddown"
trigger2 = AILevel > 0
trigger2 = P2StateType = C
value = 131

; Guard state in standard guard-number range, retaining common guard-hit handling.
[Statedef 131]
type = C
movetype = I
physics = C
anim = 131
ctrl = 0
velset = 0,0
[State 131, Release]
type = ChangeState
trigger1 = AILevel = 0
trigger1 = command != "holdback"
trigger2 = AILevel > 0
trigger2 = P2MoveType != A
trigger2 = Time > 8
trigger3 = AILevel > 0
trigger3 = Abs(P2BodyDist X) > 88.636364
trigger4 = RoundState != 2
value = 140
[State 131, Guard height]
type = ChangeState
trigger1 = AILevel = 0
trigger1 = command != "holddown"
trigger2 = AILevel > 0
trigger2 = P2StateType != C
value = 130

; Guard state in standard guard-number range, retaining common guard-hit handling.
[Statedef 132]
type = A
movetype = I
physics = A
anim = 132
ctrl = 0

[State 132, Release]
type = ChangeState
trigger1 = AILevel = 0
trigger1 = command != "holdback"
trigger2 = AILevel > 0
trigger2 = P2MoveType != A
trigger2 = Time > 8
trigger3 = AILevel > 0
trigger3 = Abs(P2BodyDist X) > 88.636364
trigger4 = RoundState != 2
value = 140

[Statedef -3]

[State -3, JUS Own state marker]
type = VarSet
trigger1 = 1
v = 59
value = GameTime
ignorehitpause = 1


[State -3, JUS Real landing or new round reset 32]
type = VarSet
trigger1 = RoundState != 2
trigger2 = Pos Y >= 0 && Vel Y >= 0 && MoveType != H && (StateNo = 0 || StateNo = 10 || StateNo = 11 || StateNo = 12 || StateNo = 20 || StateNo = 21 || StateNo = 52 || StateNo = 106 || StateNo = 601 || StateNo = 611 || StateNo = 621 || StateNo = 1101)
v = 32
value = 0

[State -3, JUS Real landing or new round reset 12]
type = VarSet
trigger1 = RoundState != 2
trigger2 = Pos Y >= 0 && Vel Y >= 0 && MoveType != H && (StateNo = 0 || StateNo = 10 || StateNo = 11 || StateNo = 12 || StateNo = 20 || StateNo = 21 || StateNo = 52 || StateNo = 106 || StateNo = 601 || StateNo = 611 || StateNo = 621 || StateNo = 1101)
v = 12
value = 0

[State -3, JUS Real landing or new round reset 13]
type = VarSet
trigger1 = RoundState != 2
trigger2 = Pos Y >= 0 && Vel Y >= 0 && MoveType != H && (StateNo = 0 || StateNo = 10 || StateNo = 11 || StateNo = 12 || StateNo = 20 || StateNo = 21 || StateNo = 52 || StateNo = 106 || StateNo = 601 || StateNo = 611 || StateNo = 621 || StateNo = 1101)
v = 13
value = 0

; JUS-owned 40/45/50/52 removes hidden host airjump counters. Existing ascent/landing
; artwork is reused honestly; independent second-jump reaction art/FX is still pending.
[Statedef 700]
type = S
movetype = I
physics = S
anim = 40
ctrl = 0
[State 700, JUS CPU shares ground admission]
type = VarSet
trigger1 = 1
v = 47
value = 1
[State 700, JUS same ground startup]
type = ChangeState
trigger1 = 1
value = 40
ctrl = 0
[Statedef 40]
type = S
movetype = I
physics = N
anim = 40
ctrl = 0
velset = 0,0

[State 40, JUS Reject inactive round ground entry]
type = ChangeState
trigger1 = Time = 0
trigger1 = RoundState != 2 || Alive = 0
value = 0
ctrl = 1

[State 40, JUS Capture jump direction]
type = VarSet
trigger1 = Time = 0
v = 46
value = ifelse(AILevel > 0,1,ifelse(command = "holdfwd",ifelse(PrevStateNo = 100,2,1),ifelse(command = "holdback",-1,0)))

[State 40, JUS Six tick ground preparation]
type = VelSet
triggerall = RoundState = 2
triggerall = Alive
triggerall = Life > 0
triggerall = !IsHelper
triggerall = HitPauseTime = 0
trigger1 = Time = 6
x = ifelse(var(46) = 2,Const(velocity.runjump.fwd.x),ifelse(var(46) = 1,Const(velocity.jump.fwd.x),ifelse(var(46) = -1,Const(velocity.jump.back.x),Const(velocity.jump.neu.x))))
y = Const(velocity.jump.y)

[State 40, JUS Ground takeoff]
type = ChangeState
trigger1 = Time = 6
value = 50
ctrl = 1

[Statedef 45]
type = A
movetype = I
physics = N
anim = 41
ctrl = 0


[State 45, R8 consume air buffer]
type = VarSet
ignorehitpause = 1
trigger1 = Time = 0
v = 57
value = 0
[State 45, JUS Reject unadmitted or exhausted air jump]
type = ChangeState
trigger1 = Time = 0
trigger1 = var(32) != 0 || RoundState != 2 || Alive = 0 || Pos Y > -Const(movement.airjump.height)
value = 50
ctrl = 1

[State 45, JUS Consume only extra jump]
type = VarSet
trigger1 = Time = 0
v = 32
value = 1

[State 45, JUS Consume fresh air jump buffer]
type = VarSet
trigger1 = Time = 0
v = 57
value = 0

[State 45, JUS Air impulse same human CPU]
type = VelSet
triggerall = RoundState = 2
triggerall = Alive
triggerall = Life > 0
triggerall = !IsHelper
triggerall = HitPauseTime = 0
trigger1 = Time = 0
x = ifelse(AILevel > 0,Const(velocity.airjump.fwd.x),ifelse(command = "holdfwd",Const(velocity.airjump.fwd.x),ifelse(command = "holdback",Const(velocity.airjump.back.x),Const(velocity.airjump.neu.x))))
y = Const(velocity.airjump.y)

[State 45, JUS Gravity during two tick air reaction]
type = VelAdd
trigger1 = Time < 2
y = Const(movement.yaccel)

[State 45, JUS Finish air reaction]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

[Statedef 50]
type = A
movetype = I
physics = N
anim = 41
ctrl = 1

[State 50, JUS Directional existing ascent pose]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse(Vel X > 0,42,ifelse(Vel X < 0,43,41))

[State 50, JUS Directional existing descent pose]
type = ChangeAnim
trigger1 = Vel Y > -2
trigger1 = Anim = 41 || Anim = 42 || Anim = 43
value = ifelse(Vel X > 0,45,ifelse(Vel X < 0,46,44))

[State 50, JUS One gravity step]
type = VelAdd
trigger1 = 1
y = Const(movement.yaccel)

[State 50, JUS Actual floor contact]
type = ChangeState
trigger1 = Pos Y >= 0
trigger1 = Vel Y > 0
value = 52
ctrl = 0

[Statedef 52]
type = S
movetype = I
physics = S
anim = 47
ctrl = 0
velset = 0,0

[State 52, JUS Floor]
type = PosSet
trigger1 = 1
y = 0

[State 52, JUS Landing recovery]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


