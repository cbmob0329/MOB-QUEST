[Statedef 801]
type = U
movetype = A
physics = N
anim = 801
ctrl = 0
poweradd = 0
juggle = 0

[State 801, air throw keeps gravity]
type = VelAdd
trigger1 = StateType = A
y = .44

[State 801, throw floor clamp]
type = PosSet
trigger1 = StateType = A && Pos Y >= 0 && Vel Y > 0
y = 0

[State 801, throw actual landing]
type = StateTypeSet
