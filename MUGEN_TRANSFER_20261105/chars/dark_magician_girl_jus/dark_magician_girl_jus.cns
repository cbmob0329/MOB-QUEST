; Approved168 eight-move implementation. Static/source verification only; no engine playtest.
; vars20 jump,21 air budget,28 release,30/31 cast meter,32 serial,33 target,34 reservation,35 hit ordinal,40 barrier,41/42 cooldown.
[Data]
life = 1000
power = 3000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 40
airjuggle = 4
sparkno = -1
guard.sparkno = -1
[Size]
xscale = .5
yscale = .5
ground.back = 12
ground.front = 12
air.back = 12
air.front = 12
height = 63
attack.dist = 75
proj.attack.dist = 100
head.pos = 0,-80
mid.pos = 0,-43
shadowoffset = 0
draw.offset = 0,0
[Velocity]
walk.fwd = 2.8
walk.back = -2.4
run.fwd = 5.8,0
run.back = -4.5,-3
jump.neu = 0,-8.8
jump.back = -3.1
jump.fwd = 3.1
runjump.back = -3.2,-8.5
runjump.fwd = 4.6,-8.5
airjump.neu = 0,-8
airjump.back = -3.1
airjump.fwd = 3.1
[Movement]
airjump.num = 1
airjump.height = 25
yaccel = .44
stand.friction = .82
crouch.friction = .82
[Statedef -2]

[State -2, interrupted throw releases only its captured victim]
type = TargetState
triggerall = !IsHelper
triggerall = NumTarget(800) > 0
triggerall = (Target(800), ID) = var(47)
triggerall = (Target(800), StateNo) = 810
trigger1 = StateNo != 801 || !Alive || RoundState != 2
ID = 800
value = 811
ignorehitpause = 1

; Core enabled only by successful static package assembly. Specials remain gated.
[State -2, core gate]
type = VarSet
triggerall = !IsHelper
trigger1 = 1
v = 59
value = 1
[State -2, normal gate]
type = VarSet
triggerall = !IsHelper
trigger1 = 1
v = 58
value = 1
[State -2, special gate]
type = VarSet
triggerall = !IsHelper
trigger1 = 1
v = 57
value = 1
[State -2, super gate]
type = VarSet
triggerall = !IsHelper
trigger1 = 1
v = 56
value = 1
[State -2, jump reset only grounded]
type = VarSet
triggerall = !IsHelper
trigger1 = StateType != A
v = 20
value = 0
[State -2, shared ledger reset]
type = VarSet
triggerall = !IsHelper
trigger1 = RoundState != 2
trigger2 = !Alive
trigger3 = NumEnemy = 0
trigger4 = NumEnemy = 1
trigger4 = EnemyNear, StateType != A
trigger4 = EnemyNear, MoveType != H
trigger5 = NumEnemy = 2
trigger5 = EnemyNear(0), StateType != A
trigger5 = EnemyNear(0), MoveType != H
trigger5 = EnemyNear(1), StateType != A
trigger5 = EnemyNear(1), MoveType != H
v = 21
value = 0
[State -2, track opponent identity]
type = VarSet
triggerall = !IsHelper
trigger1 = 1
v = 24
value = EnemyNear, ID


[State -2, skill pending meter award]
type = PowerAdd
triggerall = !IsHelper
triggerall = Alive && RoundState = 2
trigger1 = var(31) > 0 && var(30) < 240
value = ifelse(var(30)+var(31)>240,240-var(30),var(31))

[State -2, skill cap update]
type = VarSet
triggerall = !IsHelper
trigger1 = var(31) > 0
v = 30
value = ifelse(var(30)+var(31)>240,240,var(30)+var(31))

[State -2, clear pending award]
type = VarSet
triggerall = !IsHelper
trigger1 = 1
v = 31
value = 0

[State -2, cooldown 41]
type = VarAdd
triggerall = !IsHelper
trigger1 = var(41) > 0
v = 41
value = -1

[State -2, cooldown 42]
type = VarAdd
triggerall = !IsHelper
trigger1 = var(42) > 0
v = 42
value = -1

[State -2, released up arms second jump]
type = VarSet
triggerall = !IsHelper
trigger1 = command != "holdup"
v = 28
value = 1

[State -2, ground resets up latch]
type = VarSet
triggerall = !IsHelper
trigger1 = StateType != A && Pos Y >= 0
v = 28
value = 0

