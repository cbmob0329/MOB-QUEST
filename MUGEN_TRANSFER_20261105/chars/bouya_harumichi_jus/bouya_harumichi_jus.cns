; SHARED_EPISODE_NO_RETARGET_REFUND
; CINEMATIC_PRELUDE_V2
; Eight-move candidate. 27 normal states with explicit shared original-contact choreography. Runtime untested.
[Data]
life = 1000
power = 3000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 35
airjuggle = 16
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
IntPersistIndex = 60
FloatPersistIndex = 40
[Size]
xscale = .5
yscale = .5
ground.back = 12
ground.front = 13
air.back = 11
air.front = 11
height = 63
attack.dist = 60
proj.attack.dist = 60
proj.doscale = 0
head.pos = 0,-53
mid.pos = 0,-30
shadowoffset = 0
draw.offset = 0,0
[Velocity]
walk.fwd = 2.5
walk.back = -2.1
run.fwd = 6.8,0
run.back = -3.8,-3.8
jump.neu = 0,-7.6
jump.back = -2.8
jump.fwd = 3.2
runjump.back = -2.8,-7.6
runjump.fwd = 4.6,-7.6
airjump.neu = 0,-7.0
airjump.back = -2.8
airjump.fwd = 3.2
air.gethit.groundrecover = -.15,-3.2
air.gethit.airrecover.mul = .5,.2
air.gethit.airrecover.add = 0,-4.0
air.gethit.airrecover.back = -1
air.gethit.airrecover.fwd = 0
air.gethit.airrecover.up = -2
air.gethit.airrecover.down = 1.5
[Movement]
airjump.num = 1
airjump.height = 16
yaccel = .48
stand.friction = .82
crouch.friction = .82
stand.friction.threshold = .05
crouch.friction.threshold = .05
air.gethit.groundlevel = 0
air.gethit.groundrecover.ground.threshold = -16
air.gethit.groundrecover.groundlevel = 0
air.gethit.airrecover.threshold = -1
air.gethit.airrecover.yaccel = .35
air.gethit.trip.groundlevel = 0
down.bounce.offset = 0,0
down.bounce.yaccel = .4
down.bounce.groundlevel = 0
down.friction.threshold = .05

[Statedef -3]

[State -3, Owned tick stamp]
type = VarSet
trigger1 = 1
v = 58
value = GameTime
ignorehitpause = 1


[State -3, previous target air]
type = VarSet
triggerall = !IsHelper && NumEnemy > 0
triggerall = HitPauseTime = 0
triggerall = Alive && RoundState = 2
trigger1 = 1
v = 49
value = var(48)

[State -3, previous target ID]
type = VarSet
triggerall = !IsHelper && NumEnemy > 0
triggerall = HitPauseTime = 0
triggerall = Alive && RoundState = 2
trigger1 = 1
v = 50
value = var(51)

[State -3, current target air]
type = VarSet
triggerall = !IsHelper && NumEnemy > 0
triggerall = HitPauseTime = 0
triggerall = Alive && RoundState = 2
trigger1 = 1
v = 48
value = P2StateType = A

[State -3, current target ID]
type = VarSet
triggerall = !IsHelper && NumEnemy > 0
triggerall = HitPauseTime = 0
triggerall = Alive && RoundState = 2
trigger1 = 1
v = 51
value = EnemyNear, ID

[Statedef -2]

; Finite armor is renewed for one tick only in 1000/1200 clocks 6..10.
; Let that receipt expire naturally: a per-tick time=0 override suppressed guard in MUGEN1.1.

[State -2, Remove physical cast effects on interrupt]
type = RemoveExplod
trigger1 = !Alive || RoundState != 2
trigger2 = MoveType = H


[State -2, Cutin 19001 ends outside authored super]
type = RemoveExplod
trigger1 = StateNo != 3000 && StateNo != 3100 && StateNo != 3200 && StateNo != 3300
ID = 19001

[State -2, Cutin 19002 ends outside authored super]
type = RemoveExplod
trigger1 = StateNo != 3000 && StateNo != 3100 && StateNo != 3200 && StateNo != 3300
ID = 19002

[State -2, Stop original cue channels on interrupt]
type = StopSnd
trigger1 = !Alive || RoundState != 2
trigger2 = MoveType = H
channel = 4


[State -2, Reset jump only settled controllable ground or inactive round]
type = VarSet
trigger1 = RoundState != 2
trigger2 = var(58) = GameTime
trigger2 = Alive && MoveType != H && StateType != A && Pos Y >= 0
trigger2 = StateNo = 0 || StateNo = 11 || StateNo = 20 || StateNo = 21 || StateNo = 52
v = 0
value = 0

[State -2, Reset victim only round end or resolved target]
type = VarSet
trigger1 = RoundState != 2 || !Alive
v = 40
value = 0

[State -2, Release episode only all 1 enemies resolved]
type = VarSet
triggerall = NumEnemy = 1
triggerall = var(40) > 0
trigger1 = (Enemy(0), Alive) = 0 || ((Enemy(0), StateType != A) && (Enemy(0), Pos Y) >= 0 && (Enemy(0), MoveType != H))
v = 40
value = 0

[State -2, Release episode only all 2 enemies resolved]
type = VarSet
triggerall = NumEnemy = 2
triggerall = var(40) > 0
trigger1 = (Enemy(0), Alive) = 0 || ((Enemy(0), StateType != A) && (Enemy(0), Pos Y) >= 0 && (Enemy(0), MoveType != H))
trigger1 = (Enemy(1), Alive) = 0 || ((Enemy(1), StateType != A) && (Enemy(1), Pos Y) >= 0 && (Enemy(1), MoveType != H))
v = 40
value = 0

[State -2, Clear budget only inactive victim]
type = VarSet
trigger1 = var(40) = 0
v = 41
value = 0


[State -2, Was this the first episode contact]
type = VarSet
triggerall = var(58) = GameTime
triggerall = NumTarget > 0
triggerall = HitCount > var(9)
triggerall = (StateNo = [200,222]) || (StateNo = [400,422]) || (StateNo = [600,622]) || StateNo = 800 || StateNo = 801 || StateNo = 1000 || StateNo = 1100 || StateNo = 1200 || StateNo = 1300
trigger1 = Target, StateType = A
v = 46
value = var(40) = 0

[State -2, Register actual airborne victim]
type = VarSet
triggerall = var(58) = GameTime
triggerall = !IsHelper && RoundState = 2 && Alive
triggerall = (StateNo = [200,222]) || (StateNo = [400,422]) || (StateNo = [600,622]) || StateNo = 800 || StateNo = 801 || StateNo = 1000 || StateNo = 1100 || StateNo = 1200 || StateNo = 1300
triggerall = NumTarget > 0
triggerall = HitCount > var(9)
trigger1 = (Target, StateType = A)
v = 40
value = Target, ID

[State -2, Count actual airborne hit once]
type = VarAdd
triggerall = var(58) = GameTime
triggerall = !IsHelper && RoundState = 2 && Alive
triggerall = (StateNo = [200,222]) || (StateNo = [400,422]) || (StateNo = [600,622]) || StateNo = 800 || StateNo = 801 || StateNo = 1000 || StateNo = 1100 || StateNo = 1200 || StateNo = 1300
triggerall = StateNo < 1000 || var(42) = 0
triggerall = NumTarget > 0
triggerall = var(46) = 0 || var(50) != (Target, ID) || var(49) = 1
triggerall = HitCount > var(9)
trigger1 = (Target, StateType = A)
v = 41
value = ifelse(StateNo >= 1000,1,HitCount-var(9))

[State -2, Mark skill air charge after shared ledger]
type = VarSet
triggerall = StateNo = 1000 || StateNo = 1100 || StateNo = 1200 || StateNo = 1300
triggerall = NumTarget > 0
triggerall = HitCount > var(9)
trigger1 = Target, StateType = A
v = 42
value = 1

[State -2, Observe actual hit count]
type = VarSet
triggerall = (StateNo = [200,222]) || (StateNo = [400,422]) || (StateNo = [600,622]) || StateNo = 800 || StateNo = 801 || StateNo = 1000 || StateNo = 1100 || StateNo = 1200 || StateNo = 1300
trigger1 = HitCount > var(9)
v = 9
value = HitCount

[State -2, Delayed public-state AI attack]
type = VarSet
triggerall = AILevel > 0 && !IsHelper && NumEnemy > 0
triggerall = RoundState = 2 && Alive
trigger1 = GameTime % 12 = 0
v = 20
value = (P2BodyDist X = [0,42]) && P2MoveType != A

[State -2, Delayed public-state AI guard]
type = VarSet
triggerall = AILevel > 0 && !IsHelper && NumEnemy > 0
triggerall = RoundState = 2 && Alive
trigger1 = GameTime % 12 = 0
v = 21
value = P2MoveType = A && (P2BodyDist X = [0,75])

[State -2, Delayed public-state AI approach]
type = VarSet
triggerall = AILevel > 0 && !IsHelper && NumEnemy > 0
triggerall = RoundState = 2 && Alive
trigger1 = GameTime % 12 = 0
v = 22
value = P2BodyDist X > 42

[State -2, Delayed public-state AI jump]
type = VarSet
triggerall = AILevel > 0 && !IsHelper && NumEnemy > 0
triggerall = RoundState = 2 && Alive
trigger1 = GameTime % 12 = 0
v = 23
value = P2StateType = A && P2BodyDist X < 90

[State -2, Delayed public-state AI choice]
type = VarSet
triggerall = AILevel > 0 && !IsHelper && NumEnemy > 0
triggerall = RoundState = 2 && Alive
triggerall = Ctrl
trigger1 = GameTime % 12 = 0
v = 24
value = (GameTime / 12) % 7

[State -2, Up released arms next jump press]
type = VarSet
trigger1 = command != "holdup"
v = 11
value = 0

[State -2, Jump start consumes upward edge]
type = VarSet
trigger1 = Time = 0
trigger1 = StateNo = 40 || StateNo = 45 || StateNo = 700
v = 11
value = 1

[State -2, Airjump starts consume exactly one extra jump]
type = VarSet
trigger1 = Time = 0
trigger1 = StateNo = 45
v = 10
value = 1

[State -2, Only actual grounded landing refunds extra jump]
type = VarSet
trigger1 = StateType != A
trigger1 = Pos Y >= 0
trigger1 = MoveType != H
trigger1 = StateNo != 45
v = 10
value = 0


[State -2, Delayed public guard height sample]
type = VarSet
triggerall = AILevel > 0 && NumEnemy > 0
trigger1 = GameTime % 12 = 0
v = 25
value = P2StateType = C

[Statedef 200]
type = S
movetype = A
physics = S
ctrl = 0
anim = 200

poweradd = 0
movehitpersist = 0
hitcountpersist = 0

