triggerall = Time >= 1 && Time < 6
triggerall = P2Dist X > 0 && P2BodyDist X > 3 && P2BodyDist X <= 120
triggerall = FrontEdgeBodyDist > 5.2
trigger1 = Abs(P2Dist Y) < 48
x = IfElse(P2BodyDist X > 6.2,3.2,P2BodyDist X-3)


