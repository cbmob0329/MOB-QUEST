[Statedef 8050]
type=S
movetype=A
physics=N
anim=8000
ctrl=0
velset=10,0

[State 8050, Combo remember cast]
type = VarSet
trigger1 = Time=0
v = 0
value = Parent,StateNo

[State 8050, Combo air shot slope]
type = VarSet
trigger1 = Time=0 && (Parent,StateType=A)
fv = 0
value = (P2Dist Y-32)/ifelse(abs(P2Dist X)>10,abs(P2Dist X)/10.0,1)

[State 8050, Combo air shot aims at current torso]
type = VelSet
trigger1 = Time=0 && (Parent,StateType=A)
x = 10
y = ifelse(fvar(0)<-6,-6,ifelse(fvar(0)>6,6,fvar(0)))

[State 8050, Combo no push]
type = PlayerPush
trigger1 = 1
value = 0

[State 8050, Combo pulse contact]
type = HitDef
trigger1 = Time=0
attr = S,NP
hitflag = MAF
guardflag = MA
damage = floor(40*(1+.20*(Root,var(30)))),0
pausetime = 0,8
sparkno = -1
guard.sparkno = 40
hitsound = S0,1
guardsound = S0,4
ground.type = High
ground.hittime = 24
ground.slidetime = 10
ground.velocity = -.6
air.velocity = -.5,-1
air.hittime = 24
fall = 0
air.fall = 0
fall.recover = 1
hitonce = 1
getpower = 0,0
givepower = 20,10
persistent = 0

[State 8050, Combo contact belongs to this cast]
type = ParentVarSet
trigger1 = MoveContact && (Parent,StateNo)=var(0)
v = 26
value = 1
persistent = 0

[State 8050, Combo normal pulse meter]
type = ParentVarAdd
trigger1 = MoveContact
v = 37
value = ifelse(MoveHit,45,10)
persistent = 0

[State 8050, Combo cleanup]
type = DestroySelf
trigger1 = MoveContact || Time>60 || FrontEdgeBodyDist < -80 || RoundState!=2


