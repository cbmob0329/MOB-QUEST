[Statedef -2]
type = S
movetype = I
physics = S


[State -2, buff default]
type = VarSet
trigger1 = !IsHelper
v = 30
value = 0
ignorehitpause = 1

[State -2, active soul only]
type = VarSet
triggerall = !IsHelper && NumHelper(7000) > 0
trigger1 = Helper(7000), StateNo = 7000
trigger1 = Helper(7000), var(1) = 1
trigger1 = Helper(7000), var(0) > 0
v = 30
value = 1
ignorehitpause = 1

[State -2, initialize damage ledger]
type = VarSet
trigger1 = !IsHelper && (RoundState != 2 || !var(35))
v = 32
value = Life
ignorehitpause = 1

[State -2, damage ledger ready]
type = VarSet
trigger1 = !IsHelper
v = 35
value = 1
ignorehitpause = 1

[State -2, damage before adjustment]
type = VarSet
trigger1 = !IsHelper
v = 34
value = ifelse(var(32)>Life,var(32)-Life,0)
ignorehitpause = 1

[State -2, normal defense without soul]
type = LifeAdd
trigger1 = !IsHelper && !var(33) && var(34) > 0 && MoveType = H && (GetHitVar(damage) > 0 || var(38) > 0) && RoundState = 2
value = -floor(var(34)*.25)
absolute = 1
kill = 1
ignorehitpause = 1

[State -2, remember pending hit damage]
type = VarSet
trigger1 = !IsHelper
v = 38
value = ifelse(MoveType=H,GetHitVar(damage),0)
ignorehitpause = 1

[State -2, publish reconciled damage to soul]
type = VarSet
trigger1 = !IsHelper
v = 36
value = ifelse(var(32)>Life,var(32)-Life,0)
ignorehitpause = 1

[State -2, store reconciled life]
type = VarSet
trigger1 = !IsHelper
v = 32
value = Life
ignorehitpause = 1

[State -2, store protection for next hit]
type = VarSet
trigger1 = !IsHelper
v = 33
value = var(30) && Life > 0 && RoundState = 2
ignorehitpause = 1

[State -2, visual effect]
type = Explod
trigger1 = !IsHelper && Alive && RoundState = 2 && GameTime % 18 = 0 && MoveType != H
anim = 8222
ID = 8222
pos = 0,-7
postype = p1
bindtime = 1
removetime = -2
sprpriority = 3
ownpal = 1
vel = 0,-.15
trans = addalpha
alpha = 100,256
scale = 0.3,0.3

[State -2, visual effect]
type = Explod
trigger1 = !IsHelper && MoveType = H && Time = 0
anim = 8221
ID = 8221
pos = 0,-35
postype = p1
bindtime = 1
removetime = -2
sprpriority = 3
ownpal = 1
scale = 0.35,0.35

[State -2, special contact meter]
type = PowerAdd
trigger1 = !IsHelper && var(37)>0
value = var(37)
ignorehitpause = 1

[State -2, consume meter event]
type = VarSet
trigger1 = !IsHelper
v = 37
value = 0
ignorehitpause = 1

[State -2, guard sound]
type = PlaySnd
trigger1 = !IsHelper && (StateNo = [150,155]) && Time = 0
value = 0,4
channel = 2

[State -2, hurt sound]
type = PlaySnd
trigger1 = !IsHelper && MoveType = H && Time = 0
value = 0,5
channel = 2

